import { Theme } from "theme.slint";
import { AddonSwitch } from "workspace.slint";

export struct AddonRow {
    icon: image,
    id: string,
    name: string,
    initial: string,
    author: string,
    version: string,
    badge: string,
    description: string,
    status: string,
    // 0 neutral, 1 ok, 2 update available, 3 error
    status-kind: int,
    // Empty when the row offers no main action.
    action: string,
    busy: bool,
    can-remove: bool,
    can-open: bool,
    warning: string,
    switch-label: string,
    disabled: bool,
    mixed: bool,
}

export component AddonArtwork inherits Rectangle {
    in property <image> source;
    in property <string> initial;
    in property <bool> muted;
    width: 44px; height: 44px; border-radius: 12px;
    background: root.muted ? #26303F : #223855;
    if root.source.width > 0 : Image { x: 3px; y: 3px; width: parent.width - 6px; height: parent.height - 6px; source: root.source; image-fit: contain; opacity: root.muted ? 0.55 : 1; }
    if root.source.width == 0 : Text { width: parent.width; height: parent.height; text: root.initial; color: root.muted ? Theme.text-muted : Theme.accent; font-size: parent.width / 2; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
}

// Shared primary and secondary actions.
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    // Display type and more height, for the one call to action of a screen.
    in property <bool> large;
    callback clicked;

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    height: root.large ? 46px : Theme.touch ? 44px : 30px;
    min-width: label.preferred-width + (root.large ? 40px : 24px);
    border-radius: Theme.radius;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.outline-active
        : !root.enabled ? Theme.line
        : root.danger && touch.has-hover ? Theme.danger
        : root.primary ? (touch.has-hover ? Theme.outline-active : Theme.outline-hover)
        : touch.has-hover ? Theme.outline-hover : Theme.outline;
    background: !root.enabled ? Theme.control
        : root.primary ? (touch.has-hover && !touch.pressed ? Theme.primary-hover : Theme.primary)
        : Theme.control;

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-family: root.large ? Theme.font-display : Theme.font-body;
        font-size: root.large ? 19px : 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        color: !root.enabled ? Theme.text-disabled
            : root.danger ? Theme.danger
            : root.primary ? Theme.accent-bright : Theme.accent;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    // Tab reaches the button, Space or Return presses it.
    focus := FocusScope {
        width: 0;
        height: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

// Small text-only control for secondary row actions (open, remove).
export component LinkButton inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked;

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    height: Theme.touch ? 44px : 22px;
    min-width: label.preferred-width + (Theme.touch ? 20px : 10px);

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: Theme.touch ? Theme.body : Theme.meta;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: !touch.has-hover ? Theme.text-muted : root.danger ? Theme.danger : Theme.accent;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Segmented option for language selection.
export component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    accessible-role: tab;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    option-focus := FocusScope { width: 0px; height: 0px; key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.clicked(); return accept; } reject } }
    height: Theme.touch ? 44px : 32px;
    min-width: label.preferred-width + 24px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: option-focus.has-focus ? Theme.outline-active : root.active ? Theme.outline-active : touch.has-hover ? Theme.outline-hover : Theme.outline;
    background: root.active ? Theme.primary : touch.has-hover ? Theme.control : Theme.bg;

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: Theme.body;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.active ? Theme.accent-bright : Theme.accent;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Shared single-line input for setup, search and settings.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    callback accepted();
    callback edited(string);
    in property <int> focus-request;
    changed focus-request => { input.focus(); }

    public function focus-input() {
        input.focus();
    }

    height: Theme.touch ? 44px : 38px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: input.has-focus ? Theme.outline-active : hover.has-hover ? Theme.outline-hover : Theme.outline;
    background: Theme.field;

    hover := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    if root.text == "" : Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        font-size: Theme.body;
        color: Theme.text-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        single-line: true;
        font-size: Theme.body;
        color: root.enabled ? Theme.text : Theme.text-muted;
        selection-background-color: #2E65AE;
        selection-foreground-color: Theme.accent-bright;
        vertical-alignment: center;
        accepted => { root.accepted(); }
        edited => { root.edited(self.text); }
    }
}

// Scrollable column with a palette-matched scrollbar.
export component ScrollPanel inherits Rectangle {
    in property <length> spacing: 6px;
    property <length> bar: 6px;
    property <length> overflow: max(0px, flick.content-height - flick.height);
    property <length> thumb: overflow == 0 ? root.height : max(32px, root.height * root.height / flick.content-height);

    flick := Flickable {
        x: 0;
        y: 0;
        width: root.width - root.bar - 10px;
        height: root.height;
        content-height: max(content.preferred-height, self.height);
        content := VerticalLayout {
            width: flick.width;
            spacing: root.spacing;
            alignment: start;
            @children
        }
    }

    if root.overflow > 0 : Rectangle {
        x: root.width - root.bar;
        y: 0;
        width: root.bar;
        height: root.height;
        border-radius: root.bar / 2;
        border-width: 1px;
        border-color: Theme.line;

        Rectangle {
            x: 0;
            y: (-flick.content-y / root.overflow) * (root.height - root.thumb);
            width: root.bar;
            height: root.thumb;
            border-radius: root.bar / 2;
            background: track.has-hover || track.pressed ? Theme.outline-hover : Theme.outline;
        }

        track := TouchArea {
            width: parent.width + 8px;
            x: -4px;
            height: parent.height;
            function jump() {
                flick.content-y = -clamp((self.mouse-y - root.thumb / 2) / (root.height - root.thumb), 0, 1) * root.overflow;
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.jump();
                }
            }
            moved => {
                if (self.pressed) {
                    self.jump();
                }
            }
        }
    }
}

component Pill inherits Rectangle {
    in property <string> text;
    height: 20px;
    width: label.preferred-width + 16px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.outline;
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Theme.accent;
    }
}

export component AddonRowView inherits Rectangle {
    in property <AddonRow> addon;
    callback action(); callback toggle(); callback remove(); callback open(); callback details();
    height: root.addon.warning != "" ? 146px : 118px;
    border-radius: 12px; border-width: 1px;
    border-color: root.addon.status-kind == 2 ? #36598C : hover.has-hover ? Theme.outline : Theme.line;
    background: hover.has-hover ? Theme.row-hover : Theme.row;
    hover := TouchArea { }
    HorizontalLayout {
        padding: 14px; spacing: 14px;
        VerticalLayout {
            alignment: center;
            AddonArtwork { source: root.addon.icon; initial: root.addon.initial; muted: root.addon.disabled; }
        }
        VerticalLayout {
            alignment: center; spacing: 4px; horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1; height: 24px;
                    Text { width: parent.width; height: parent.height; horizontal-alignment: left; text: root.addon.name; color: root.addon.disabled ? Theme.text-muted : Theme.text; font-size: 17px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                    TouchArea { mouse-cursor: pointer; clicked => { root.details(); } }
                }
                if root.addon.badge != "" : Pill { text: root.addon.badge; }
            }
            Text { text: root.addon.version + (root.addon.author != "" ? (root.addon.version != "" ? "  ·  " : "") + root.addon.author : ""); color: Theme.text-muted; font-size: Theme.meta; overflow: elide; }
            Text { text: root.addon.warning != "" ? root.addon.warning : root.addon.description; color: root.addon.warning != "" ? Theme.warn : Theme.text-muted; font-size: Theme.meta; wrap: word-wrap; overflow: elide; max-height: root.addon.warning != "" ? 45px : 18px; }
            HorizontalLayout {
                spacing: 12px; alignment: start;
                LinkButton { text: @tr("Details"); clicked => { root.details(); } }
                if root.addon.can-open : LinkButton { text: "GitHub"; clicked => { root.open(); } }
                if root.addon.can-remove && !root.addon.busy : LinkButton { text: @tr("Remove"); danger: true; clicked => { root.remove(); } }
            }
        }
        VerticalLayout {
            alignment: center; spacing: 10px; width: 136px;
            Text { text: root.addon.busy ? @tr("Working...") : root.addon.status; color: root.addon.status-kind == 2 ? Theme.warn : root.addon.status-kind == 1 ? Theme.ok : root.addon.status-kind == 3 ? Theme.danger : Theme.text-muted; font-size: Theme.meta; horizontal-alignment: right; overflow: elide; }
            if root.addon.action != "" : ActionButton { text: root.addon.action; primary: root.addon.status-kind == 2; enabled: !root.addon.busy; clicked => { root.action(); } }
            if root.addon.switch-label != "" : HorizontalLayout {
                alignment: end; spacing: 8px;
                Text { text: root.addon.mixed ? @tr("Mixed") : root.addon.disabled ? @tr("Disabled") : @tr("Enabled"); font-size: Theme.meta; color: root.addon.disabled ? Theme.text-muted : Theme.text; vertical-alignment: center; }
                AddonSwitch { on: !root.addon.disabled && !root.addon.mixed; mixed: root.addon.mixed; label: root.addon.switch-label + " " + root.addon.name; enabled: !root.addon.busy; clicked => { root.toggle(); } }
            }
        }
    }
}

// Full-window dim layer that swallows clicks to the UI below and centers its child.
export component Overlay inherits Rectangle {
    background: Theme.overlay;
    TouchArea {
        width: parent.width;
        height: parent.height;
    }
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            @children
        }
    }
}

// Panel with a gold-brown rim, used for the main content area.
export component Panel inherits Rectangle {
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.panel;
}

export component DialogCard inherits Rectangle {
    in property <string> title;
    width: 560px;
    height: layout.preferred-height;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.outline;
    background: Theme.panel;
    layout := VerticalLayout {
        padding: Theme.gap-loose;
        spacing: 18px;
        Text { text: root.title; color: Theme.text; font-size: 22px; font-weight: 600; wrap: word-wrap; }
        @children
    }
}

// One caption button (minimize, maximize/restore, close), sized like the Windows ones.
component CaptionButton inherits Rectangle {
    in property <string> label;
    // 0 minimize, 1 maximize, 2 restore, 3 close
    in property <int> glyph;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label;
    width: 46px;
    background: !touch.has-hover ? transparent
        : root.glyph == 3 ? Theme.primary-hover
        : touch.pressed ? Theme.bg : Theme.control;

    property <brush> stroke: touch.has-hover ? Theme.accent-bright : Theme.text-muted;

    if root.glyph == 0 : Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 0 5 L 10 5";
        stroke: root.stroke;
        stroke-width: 1px;
    }
    if root.glyph == 1 : Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z";
        stroke: root.stroke;
        stroke-width: 1px;
    }
    if root.glyph == 2 : Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 0.5 2.5 L 7.5 2.5 L 7.5 9.5 L 0.5 9.5 Z M 2.5 2.5 L 2.5 0.5 L 9.5 0.5 L 9.5 7.5 L 7.5 7.5";
        stroke: root.stroke;
        stroke-width: 1px;
    }
    if root.glyph == 3 : Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
        stroke: root.stroke;
        stroke-width: 1px;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

// Replaces the system window frame: drag area, double-click to maximize, caption buttons.
export component TitleBar inherits Rectangle {
    in property <length> sidebar-width;
    in property <string> title;
    in property <bool> maximized;
    callback start-drag();
    callback minimize();
    callback toggle-maximize();
    callback close();

    height: 34px;
    background: Theme.bg;

    if root.sidebar-width > 0px : Rectangle { x: 0; y: 0; width: root.sidebar-width; height: parent.height; background: Theme.sidebar; }
    if root.sidebar-width > 0px : Rectangle { x: root.sidebar-width; y: 0; width: 1px; height: parent.height; background: Theme.line; }

    drag := TouchArea {
        width: parent.width;
        height: parent.height;
        // Dragging starts on the first move, so a double-click still reaches us.
        moved => {
            if (self.pressed) {
                root.start-drag();
            }
        }
        double-clicked => { root.toggle-maximize(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        Text {
            text: root.title;
            font-family: Theme.font-display;
            font-size: 14px;
            color: Theme.accent;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        CaptionButton {
            label: @tr("Minimize");
            glyph: 0;
            clicked => { root.minimize(); }
        }
        CaptionButton {
            label: root.maximized ? @tr("Restore") : @tr("Maximize");
            glyph: root.maximized ? 2 : 1;
            clicked => { root.toggle-maximize(); }
        }
        CaptionButton {
            label: @tr("Close");
            glyph: 3;
            clicked => { root.close(); }
        }
    }
}

component ResizeGrip inherits TouchArea {
    in property <int> direction;
    callback start(int);
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
            root.start(root.direction);
        }
    }
}

// Invisible strips along the window edges that start a native resize, since a frameless
// window has no system border to grab. Directions: 0 N, 1 S, 2 E, 3 W, 4 NE, 5 NW, 6 SE, 7 SW.
export component ResizeEdges {
    in property <length> grip: 5px;
    callback start-resize(int);

    ResizeGrip { x: root.grip; y: 0; width: root.width - 2 * root.grip; height: root.grip; direction: 0; mouse-cursor: ns-resize; start(d) => { root.start-resize(d); } }
    ResizeGrip { x: root.grip; y: root.height - root.grip; width: root.width - 2 * root.grip; height: root.grip; direction: 1; mouse-cursor: ns-resize; start(d) => { root.start-resize(d); } }
    ResizeGrip { x: root.width - root.grip; y: root.grip; width: root.grip; height: root.height - 2 * root.grip; direction: 2; mouse-cursor: ew-resize; start(d) => { root.start-resize(d); } }
    ResizeGrip { x: 0; y: root.grip; width: root.grip; height: root.height - 2 * root.grip; direction: 3; mouse-cursor: ew-resize; start(d) => { root.start-resize(d); } }
    ResizeGrip { x: root.width - root.grip; y: 0; width: root.grip; height: root.grip; direction: 4; mouse-cursor: nesw-resize; start(d) => { root.start-resize(d); } }
    ResizeGrip { x: 0; y: 0; width: root.grip; height: root.grip; direction: 5; mouse-cursor: nwse-resize; start(d) => { root.start-resize(d); } }
    ResizeGrip { x: root.width - root.grip; y: root.height - root.grip; width: root.grip; height: root.grip; direction: 6; mouse-cursor: nwse-resize; start(d) => { root.start-resize(d); } }
    ResizeGrip { x: 0; y: root.height - root.grip; width: root.grip; height: root.grip; direction: 7; mouse-cursor: nesw-resize; start(d) => { root.start-resize(d); } }
}
