import { Theme } from "theme.slint";
import { AddonDetails } from "details.slint";
import { NavItem, FilterChip, SettingCard, EmptyState } from "workspace.slint";
import {
    AddonRow, ActionButton, TabButton, Field, ScrollPanel, AddonRowView,
    Overlay, Panel, DialogCard, TitleBar, ResizeEdges, LinkButton
} from "components.slint";

export { AddonRow, Theme }

// An AddOns folder found on this machine: short label for the button, full path to use.
export struct Suggestion {
    label: string,
    path: string,
}

// Shown under a path field when there is no file dialog to browse with.
component TypePathHint inherits Text {
    in property <bool> game-mode;
    text: @tr("Type the full path to the AddOns folder.") + (root.game-mode ? @tr(" Press STEAM + X for the on-screen keyboard.") : "");
    font-size: Theme.meta;
    color: Theme.text-muted;
    wrap: word-wrap;
}

component SetupView inherits Rectangle {
    in-out property <string> path;
    in property <string> error;
    in property <string> warning;
    in property <string> example;
    in property <bool> file-dialog;
    in property <bool> game-mode;
    in property <int> language-index;
    in property <[Suggestion]> suggestions;
    in property <bool> searching;
    callback browse(); callback confirm(); callback pick(string); callback quit(); callback language(int);
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Panel {
                width: 650px;
                VerticalLayout {
                    padding: 28px; spacing: 14px;
                    Text { text: "REBORN ADDON MANAGER"; color: Theme.accent; font-size: 12px; letter-spacing: 1px; }
                    Text { text: @tr("Connect your game"); color: Theme.text; font-size: 28px; font-weight: 600; }
                    Text { text: @tr("Choose the Interface/AddOns folder inside your Reborn installation."); color: Theme.text-muted; font-size: Theme.body; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 10px;
                        Field { text <=> root.path; placeholder: root.example; accepted => { root.confirm(); } }
                        if root.file-dialog : ActionButton { text: @tr("Browse..."); clicked => { root.browse(); } }
                    }
                    if !root.file-dialog : TypePathHint { game-mode: root.game-mode; }
                    if root.error != "" : Text { text: root.error; color: Theme.danger; font-size: Theme.meta; wrap: word-wrap; }
                    if root.warning != "" : Text { text: root.warning; color: Theme.warn; font-size: Theme.meta; wrap: word-wrap; }
                    if root.suggestions.length > 0 : ScrollPanel {
                        height: min(110px, 26px + root.suggestions.length * 40px);
                        Text { text: @tr("Found on this computer. Select one to use it:"); color: Theme.text-muted; font-size: Theme.meta; }
                        for suggestion in root.suggestions : ActionButton { text: suggestion.label; min-width: 0px; clicked => { root.pick(suggestion.path); } }
                    }
                    if root.suggestions.length == 0 : Text {
                        text: root.searching ? @tr("Searching this computer for the AddOns folder...") : @tr("Choose your game folder to get started."); color: Theme.text-muted; font-size: Theme.meta; wrap: word-wrap;
                    }
                    Rectangle { height: 1px; background: Theme.line; }
                    HorizontalLayout {
                        spacing: 8px;
                        FilterChip { width: 78px; horizontal-stretch: 0; text: "English"; active: root.language-index == 0; clicked => { root.language(0); } }
                        FilterChip { width: 78px; horizontal-stretch: 0; text: "Русский"; active: root.language-index == 1; clicked => { root.language(1); } }
                        FilterChip { width: 78px; horizontal-stretch: 0; text: "Deutsch"; active: root.language-index == 2; clicked => { root.language(2); } }
                        Rectangle { horizontal-stretch: 1; }
                        if root.game-mode : LinkButton { text: @tr("Quit"); clicked => { root.quit(); } }
                        ActionButton { horizontal-stretch: 0; text: root.warning != "" ? @tr("Use This Folder Anyway") : @tr("Continue"); primary: true; enabled: root.path != ""; clicked => { root.confirm(); } }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Reborn Addon Manager";
    icon: @image-url("../assets/branding/reborn-v2-ui.png");
    no-frame: true;
    min-width: 980px;
    min-height: 660px;
    preferred-width: 1180px;
    preferred-height: 800px;
    background: Theme.bg;
    default-font-family: Theme.font-body;

    in property <string> app-version;
    in property <string> addons-example;

    // Own window frame
    callback start-drag();
    callback start-resize(int);
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    // Steam Deck Game Mode / gamescope: fullscreen without window frame.
    in property <bool> game-mode;
    property <length> title-height: root.game-mode ? 0px : 34px;
    // False without a usable file dialog (no portal, or Game Mode): Browse and Install zip hide.
    in property <bool> file-dialog: true;

    // First start
    in property <bool> needs-setup;
    in-out property <string> setup-path;
    in property <string> setup-error;
    in property <string> setup-warning;
    in property <[Suggestion]> setup-suggestions;
    in property <bool> setup-searching: true;
    callback setup-browse();
    callback setup-confirm();

    // 0 installed, 1 browse, 2 settings
    in-out property <int> page: 0;
    in property <[AddonRow]> installed-rows;
    in property <[AddonRow]> browse-rows;
    in property <int> installed-total;
    in-out property <string> search;
    callback search-changed(string);
    in property <string> addons-dir;
    in property <int> update-count;
    in property <bool> checking;
    in property <bool> operations-running;
    property <int> search-focus;
    callback check-updates();
    callback update-all();
    callback install-zip();
    callback add-repo();
    callback open-source();
    callback open-support();
    callback open-upstream-source();
    callback restore-backup();
    callback open-backups();
    callback open-addons();
    in property <int> language-index;
    in-out property <int> list-filter;
    in property <int> enabled-total;
    in property <int> disabled-total;
    in property <bool> catalog-ready;
    callback list-filter-changed(int);
    callback copy-status();
    callback row-details(string);
    in-out property <bool> details-open;
    in property <AddonRow> detail-addon;
    in property <[string]> detail-folders;
    in property <string> detail-repo;
    property <bool> status-details;
    in-out property <bool> status-copied;
    changed status-text => { root.status-copied = false; }
    callback select-language(int);
    callback launch-game(bool);
    callback row-action(string);
    in property <bool> switches-available;
    in property <bool> can-undo;
    callback undo-remove();
    callback row-toggle(string);
    callback row-remove(string);
    callback row-open(string);

    in property <string> status-text;
    in property <bool> status-error;

    // Settings
    in-out property <string> settings-path;
    in property <string> settings-message;
    in property <bool> settings-message-error;
    callback settings-browse();
    callback settings-save();

    // Confirmation dialog
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-ok;
    in property <bool> confirm-danger;
    callback confirm-accept();
    callback confirm-cancel();

    // Add-repo dialog
    in-out property <bool> repo-open;
    in-out property <string> repo-input;
    in property <string> repo-error;
    in property <bool> repo-busy;
    callback repo-submit();
    callback repo-cancel();

    // Self-update banner, empty version = hidden
    in property <string> self-update-version;
    in property <bool> self-update-busy;
    // False for a bare Linux binary outside an AppImage: it can't replace itself.
    in property <bool> self-update-in-place: true;
    callback self-update();

    forward-focus: shell;
    shell := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.details-open { root.details-open = false; return accept; }
                if root.status-details { root.status-details = false; return accept; }
                if root.confirm-open { root.confirm-cancel(); return accept; }
                if root.repo-open && !root.repo-busy { root.repo-cancel(); return accept; }
                if root.search != "" { root.search = ""; root.search-changed(""); return accept; }
            }
            if !root.needs-setup && !root.confirm-open && !root.repo-open && !root.details-open && !root.status-details {
                if event.text == Key.F5 { root.check-updates(); return accept; }
                if event.modifiers.control {
                    if event.text == "1" || event.text == "2" || event.text == "3" { root.page = event.text == "1" ? 0 : event.text == "2" ? 1 : 2; return accept; }
                    if event.text == "f" || event.text == "F" { if root.page == 2 { root.page = 0; } root.search-focus += 1; return accept; }
                    if event.text == "u" || event.text == "U" { if root.update-count > 0 && !root.operations-running { root.update-all(); } return accept; }
                }
            }
            reject
        }
    Rectangle {
        background: Theme.bg;
    }

    if root.needs-setup : SetupView {
        y: root.title-height;
        width: parent.width;
        height: parent.height - root.title-height;
        language-index: root.language-index;
        language(index) => { root.select-language(index); }
        path <=> root.setup-path;
        error: root.setup-error;
        warning: root.setup-warning;
        example: root.addons-example;
        suggestions: root.setup-suggestions;
        searching: root.setup-searching;
        file-dialog: root.file-dialog;
        game-mode: root.game-mode;
        browse => { root.setup-browse(); }
        pick(path) => { root.setup-path = path; root.setup-confirm(); }
        confirm => { root.setup-confirm(); }
        quit => { root.close-window(); }
    }

    if !root.needs-setup : HorizontalLayout {
        y: root.title-height; width: parent.width; height: parent.height - root.title-height;
        spacing: 0px;
        Rectangle {
            width: 216px; background: Theme.sidebar;
            VerticalLayout {
                padding: 18px; padding-top: 8px; spacing: 8px;
                VerticalLayout {
                    height: root.height < 720px ? 124px : 156px;
                    padding-bottom: 8px; spacing: 4px;
                    HorizontalLayout {
                        alignment: center;
                        Image { width: root.height < 720px ? 72px : 96px; height: self.width; source: @image-url("../assets/branding/reborn-v2-ui.png"); image-fit: contain; }
                    }
                    Text { height: 22px; text: "REBORN"; horizontal-alignment: center; color: Theme.text; font-size: 18px; font-weight: 700; }
                    Text { height: 14px; text: "ADDON MANAGER"; horizontal-alignment: center; color: Theme.text-muted; font-size: 10px; letter-spacing: 1px; }
                }
                NavItem { text: @tr("Installed"); count: root.installed-total; active: root.page == 0; clicked => { root.page = 0; } }
                NavItem { text: @tr("Catalog"); active: root.page == 1; clicked => { root.page = 1; } }
                NavItem { text: @tr("Settings"); active: root.page == 2; clicked => { root.page = 2; } }
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    height: 148px; border-radius: 12px; background: #182335; border-width: 1px; border-color: Theme.line;
                    VerticalLayout {
                        padding: 12px; spacing: 8px;
                        Text { height: 12px; text: "AZEROTH SURVIVORS"; color: Theme.text-muted; font-size: 10px; letter-spacing: 0.5px; }
                        Text { height: 22px; text: "Reborn"; color: Theme.text; font-size: 19px; font-weight: 600; }
                        ActionButton { text: @tr("Check & play"); enabled: !root.operations-running; primary: true; clicked => { root.launch-game(true); } }
                        ActionButton { text: @tr("Play directly"); enabled: !root.operations-running; clicked => { root.launch-game(false); } }
                    }
                }
                VerticalLayout { spacing: 0px;
                    Text { text: @tr("Reborn version by AlexEnotov"); color: Theme.text-muted; font-size: 10px; wrap: word-wrap; }
                    HorizontalLayout { alignment: start; LinkButton { text: @tr("Report a problem"); clicked => { root.open-support(); } } }
                }
                HorizontalLayout { padding-top: 6px; Text { text: "v" + root.app-version; color: Theme.text-disabled; font-size: 11px; } Rectangle { horizontal-stretch: 1; } if root.game-mode : LinkButton { text: @tr("Quit"); clicked => { root.close-window(); } } }
            }
        }
        Rectangle { width: 1px; background: Theme.line; }
        VerticalLayout {
            padding: 28px; padding-top: 10px; spacing: 18px;
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    spacing: 6px; horizontal-stretch: 1;
                    Text { text: root.page == 0 ? @tr("Your addons") : root.page == 1 ? @tr("Discover addons") : @tr("Settings"); color: Theme.text; font-size: 28px; font-weight: 600; }
                    Text { text: root.page == 0 ? @tr("Everything installed in your Reborn client.") : root.page == 1 ? @tr("Explore the independent Reborn addon catalog.") : @tr("Make the manager work the way you want."); color: Theme.text-muted; font-size: Theme.body; wrap: word-wrap; }
                }
                if root.page != 2 : VerticalLayout {
                    alignment: center;
                    ActionButton { text: root.checking ? @tr("Checking...") : @tr("Refresh"); enabled: !root.checking; clicked => { root.check-updates(); } }
                }
            }
            if root.page != 2 : HorizontalLayout {
                spacing: 10px;
                search-field := Field { focus-request: root.search-focus; horizontal-stretch: 1; placeholder: @tr("Search addons"); text <=> root.search; edited(text) => { root.search-changed(text); } }
                if root.page == 0 && root.file-dialog : ActionButton { text: @tr("Install ZIP"); clicked => { root.install-zip(); } }
                if root.page == 0 : ActionButton { text: @tr("Add GitHub"); clicked => { root.add-repo(); } }
            }
            if root.page == 0 : HorizontalLayout {
                spacing: 4px;
                FilterChip { text: @tr("All") + "  " + root.installed-total; active: root.list-filter == 0; clicked => { root.list-filter = 0; root.list-filter-changed(0); } }
                FilterChip { text: @tr("Enabled") + "  " + root.enabled-total; active: root.list-filter == 1; clicked => { root.list-filter = 1; root.list-filter-changed(1); } }
                FilterChip { text: @tr("Disabled") + "  " + root.disabled-total; active: root.list-filter == 2; clicked => { root.list-filter = 2; root.list-filter-changed(2); } }
                FilterChip { text: @tr("Updates") + "  " + root.update-count; active: root.list-filter == 3; clicked => { root.list-filter = 3; root.list-filter-changed(3); } }
                Rectangle { horizontal-stretch: 1; }
                if root.update-count > 0 : ActionButton { text: @tr("Update all"); primary: true; clicked => { root.update-all(); } }
            }
            if root.page == 0 && root.can-undo : HorizontalLayout { Text { text: @tr("An addon was removed."); color: Theme.text-muted; font-size: Theme.meta; vertical-alignment: center; horizontal-stretch: 1; } LinkButton { text: @tr("Undo removal"); clicked => { root.undo-remove(); } } }
            if root.page == 0 && !root.switches-available : Text { text: @tr("To switch addons, first enter the game with a character, close it, then check for updates."); color: Theme.text-muted; font-size: Theme.meta; wrap: word-wrap; }
            if root.page == 0 : ScrollPanel {
                spacing: 10px; vertical-stretch: 1;
                for row in root.installed-rows : AddonRowView {
                    addon: row;
                    action => { root.row-action(row.id); } toggle => { root.row-toggle(row.id); }
                    remove => { root.row-remove(row.id); } open => { root.row-open(row.id); } details => { root.row-details(row.id); }
                }
                if root.installed-rows.length == 0 : EmptyState {
                    title: root.installed-total == 0 ? @tr("Add your first addon") : @tr("No matching addons");
                    description: root.installed-total == 0 ? @tr("Install a ZIP archive or add a GitHub repository to get started.") : @tr("Try another search or show all addons.");
                    HorizontalLayout { alignment: center;
                        if root.installed-total == 0 && root.file-dialog : ActionButton { text: @tr("Install ZIP"); primary: true; clicked => { root.install-zip(); } }
                        if root.installed-total > 0 : ActionButton { text: @tr("Clear filters"); clicked => { root.search = ""; root.search-changed(""); root.list-filter = 0; root.list-filter-changed(0); } }
                    }
                }
            }
            if root.page == 1 : ScrollPanel {
                spacing: 10px; vertical-stretch: 1;
                for row in root.browse-rows : AddonRowView { addon: row; action => { root.row-action(row.id); } open => { root.row-open(row.id); } details => { root.row-details(row.id); } }
                if root.browse-rows.length == 0 : EmptyState {
                    title: root.search != "" ? @tr("No matching addons") : root.catalog-ready ? @tr("The catalog is empty") : @tr("The catalog is not connected yet");
                    description: root.search != "" ? @tr("Try another search or show all addons.") : @tr("You can still install addons from a ZIP archive or a GitHub repository.");
                    HorizontalLayout { alignment: center; ActionButton { text: @tr("Add GitHub"); clicked => { root.add-repo(); } } }
                }
            }
            if root.page == 2 : ScrollPanel {
                spacing: 16px; vertical-stretch: 1;
                SettingCard {
                    title: @tr("Game installation"); description: @tr("Choose the Interface/AddOns folder inside your Reborn installation.");
                    HorizontalLayout { spacing: 10px; Field { text <=> root.settings-path; accepted => { root.settings-save(); } } if root.file-dialog : ActionButton { text: @tr("Browse..."); clicked => { root.settings-browse(); } } }
                    HorizontalLayout { spacing: 10px; LinkButton { text: @tr("Open AddOns folder"); clicked => { root.open-addons(); } } Rectangle { horizontal-stretch: 1; } ActionButton { text: @tr("Save folder"); primary: true; enabled: root.settings-path != root.addons-dir; clicked => { root.settings-save(); } } }
                    Text { text: @tr("Check & play runs Reborn’s update and error checks. Play directly skips these checks."); color: Theme.text-muted; font-size: Theme.meta; wrap: word-wrap; }
                    if root.settings-message != "" : Text { text: root.settings-message; color: root.settings-message-error ? Theme.danger : Theme.ok; font-size: Theme.meta; wrap: word-wrap; }
                }
                SettingCard {
                    title: @tr("Language"); description: @tr("Choose the language used in the app.");
                    HorizontalLayout { spacing: 8px; alignment: start;
                        TabButton { text: "English"; active: root.language-index == 0; clicked => { root.select-language(0); } }
                        TabButton { text: "Русский"; active: root.language-index == 1; clicked => { root.select-language(1); } }
                        TabButton { text: "Deutsch"; active: root.language-index == 2; clicked => { root.select-language(2); } }
                    }
                }
                SettingCard {
                    title: @tr("Settings backups"); description: @tr("A local copy is made before an addon is updated or removed. Close the game before restoring.");
                    HorizontalLayout { spacing: 10px; alignment: start;
                        ActionButton { text: @tr("Restore settings backup"); clicked => { root.restore-backup(); } }
                        ActionButton { text: @tr("Open backups folder"); clicked => { root.open-backups(); } }
                    }
                }
                SettingCard {
                    title: @tr("About"); description: "Reborn Addon Manager · v" + root.app-version;
                    Text { text: @tr("Adapted and maintained by AlexEnotov."); color: Theme.text; font-size: 13px; wrap: word-wrap; }
                    Text { text: @tr("Report issues with this Reborn version to AlexEnotov."); color: Theme.text-muted; font-size: Theme.meta; wrap: word-wrap; }
                    HorizontalLayout { alignment: start; spacing: 12px;
                        LinkButton { text: @tr("Report a problem"); clicked => { root.open-support(); } }
                        LinkButton { text: @tr("Source code"); clicked => { root.open-source(); } }
                    }
                    Rectangle { height: 1px; background: Theme.line; }
                    Text { text: @tr("Based on SurvivorsForge by Rezondes.") + " AGPL-3.0-or-later"; color: Theme.text-muted; font-size: Theme.meta; wrap: word-wrap; }
                    HorizontalLayout { alignment: start; LinkButton { text: @tr("Original source"); clicked => { root.open-upstream-source(); } } }
                }
            }
            if root.page == 0 && root.switches-available : Text { text: @tr("Switches apply to all existing characters. Close the game before making changes."); color: Theme.text-muted; font-size: Theme.meta; wrap: word-wrap; }
            Rectangle {
                height: 36px; border-width: 0px; background: transparent;
                HorizontalLayout { spacing: 10px;
                    VerticalLayout { alignment: center; Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.status-error ? Theme.danger : root.checking || root.operations-running ? Theme.warn : Theme.ok; } }
                    Text { text: root.status-text != "" ? root.status-text : @tr("Ready"); color: root.status-error ? Theme.danger : Theme.text-muted; font-size: Theme.meta; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    if root.status-text != "" : LinkButton { text: @tr("Details"); clicked => { root.status-copied = false; root.status-details = true; } }
                }
            }
        }
    }

    if root.details-open : Overlay {
        y: root.title-height; width: parent.width; height: parent.height - root.title-height;
        AddonDetails { addon: root.detail-addon; folders: root.detail-folders; repo: root.detail-repo; close => { root.details-open = false; } open-source => { root.row-open(root.detail-addon.id); } }
    }

    if root.status-details : Overlay {
        y: root.title-height; width: parent.width; height: parent.height - root.title-height;
        DialogCard {
            title: @tr("Activity details");
            ScrollPanel { height: 280px; Text { text: root.status-text; color: Theme.text; font-size: Theme.body; wrap: word-wrap; } }
            HorizontalLayout { alignment: end; spacing: 10px;
                if root.status-details : ActionButton { text: root.status-copied ? @tr("Copied") : @tr("Copy"); clicked => { root.copy-status(); } }
                ActionButton { text: @tr("Close"); primary: true; clicked => { root.details-open = false; root.status-details = false; } }
            }
        }
    }

    if root.repo-open : Overlay {
        y: root.title-height;
        width: parent.width;
        height: parent.height - root.title-height;
        DialogCard {
            title: @tr("Add GitHub Repo");
            Text {
                text: @tr("Checks the latest release, tags, and default branch for an addon.");
                font-size: Theme.body;
                color: Theme.text;
                wrap: word-wrap;
            }
            Field {
                text <=> root.repo-input;
                placeholder: "owner/repo or https://github.com/owner/repo";
                enabled: !root.repo-busy;
                init => { self.focus-input(); }
                accepted => { root.repo-submit(); }
            }
            if root.repo-error != "" : Text {
                text: root.repo-error;
                font-size: Theme.body;
                color: Theme.danger;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: Theme.gap-tight;
                ActionButton {
                    text: @tr("Cancel");
                    enabled: !root.repo-busy;
                    clicked => { root.repo-cancel(); }
                }
                ActionButton {
                    text: root.repo-busy ? @tr("Checking...") : @tr("Check repo");
                    primary: true;
                    enabled: !root.repo-busy && root.repo-input != "";
                    clicked => { root.repo-submit(); }
                }
            }
        }
    }

    if root.confirm-open : Overlay {
        y: root.title-height;
        width: parent.width;
        height: parent.height - root.title-height;
        DialogCard {
            title: root.confirm-title;
            Text {
                text: root.confirm-text;
                font-size: Theme.body;
                color: Theme.text;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: Theme.gap-tight;
                ActionButton {
                    text: @tr("Cancel");
                    clicked => { root.confirm-cancel(); }
                }
                ActionButton {
                    text: root.confirm-ok;
                    primary: !root.confirm-danger;
                    danger: root.confirm-danger;
                    clicked => { root.confirm-accept(); }
                }
            }
        }
    }

    if !root.game-mode : TitleBar {
        x: 0;
        y: 0;
        width: parent.width;
        title: "";
        sidebar-width: root.needs-setup ? 0px : 216px;
        maximized: root.maximized;
        start-drag => { root.start-drag(); }
        minimize => { root.minimize(); }
        toggle-maximize => { root.toggle-maximize(); }
        close => { root.close-window(); }
    }

    if !root.maximized && !root.game-mode : ResizeEdges {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        start-resize(direction) => { root.start-resize(direction); }
    }
    }
}
